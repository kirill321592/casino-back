PORT=3000
CORS_ORIGIN=http://localhost:5173
MAX_BET=100000

# Auth. JWT_SECRET is required in production (32+ chars); in development an
# ephemeral one is generated per process, so a restart signs everyone out.
JWT_SECRET=
JWT_TTL_SECONDS=43200
# Leave these unset outside production: dev runs on plain http, and
# localhost:5173 -> localhost:3000 is same-site, so `lax` already works.
COOKIE_SECURE=
COOKIE_SAME_SITE=lax

# Wallet
STARTING_BALANCE=1000

# Roulette
ROUND_DURATION_MS=15000
ROUND_BREAK_MS=3000
